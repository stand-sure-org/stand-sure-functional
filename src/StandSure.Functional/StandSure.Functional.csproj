<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>$(FunctionalRootName)</RootNamespace>
    <AssemblyName>$(FunctionalRootName)</AssemblyName>
    <PackageId>$(FunctionalRootName)</PackageId>
    <!-- Pre-1.0: the hidden Ok/Fail aliases and other names may still change before a stable release. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>C. J. Anderson</Authors>
    <Company>Stand Sure, LLC</Company>
    <Copyright>Copyright (c) 2026 C. J. Anderson, Stand Sure, LLC</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Allocation-conscious Result, Option and Error types for C#.</Description>
    <!-- Pack on every build so tests/StandSure.Functional.PackageTests always consumes the current package. -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>$(FunctionalPackageOutputPath)</PackageOutputPath>
    <DefaultDocumentationGeneratedAccessModifiers>Public,Protected,ProtectedInternal</DefaultDocumentationGeneratedAccessModifiers>
    <DefaultDocumentationFolder>docs</DefaultDocumentationFolder>
    <DefaultDocumentationFileNameFactory>DirectoryName</DefaultDocumentationFileNameFactory>

  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' != 'Debug' ">
    <DisableDefaultDocumentation>true</DisableDefaultDocumentation>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(CI)' == 'true' ">
    <DisableDefaultDocumentation>true</DisableDefaultDocumentation>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Global using for consumers; tests/StandSure.Functional.PackageTests checks it against the packed .nupkg. -->
    <None Include="buildTransitive/StandSure.Functional.props" Pack="true" PackagePath="buildTransitive/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <!-- The one-page API summary, so a consuming repository (or its template) can copy it next to its CLAUDE.md. -->
    <None Include="../../docs/llm-api-summary.md" Pack="true" PackagePath="docs/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DefaultDocumentation" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <!--
    Agent skill: skills/stand-sure-functional/SKILL.md inside the package, the path agent tooling (dotnet-inspect and
    others) discovers. Generated at pack time from skills/SKILL.frontmatter.md plus docs/llm-api-summary.md, so the
    summary stays the single source (the harness uses it verbatim as the with-library prompt, without frontmatter).
    Hooked in through NuGet's supported TargetsForTfmSpecificContentInPackage (single TFM, so it runs once).
    Escape keeps the summary's semicolons from being split into separate lines by WriteLinesToFile.
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);GenerateAgentSkill</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="GenerateAgentSkill">
    <PropertyGroup>
      <AgentSkillFile>$(IntermediateOutputPath)skills/stand-sure-functional/SKILL.md</AgentSkillFile>
      <AgentSkillText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/skills/SKILL.frontmatter.md').TrimEnd())

$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../../docs/llm-api-summary.md').TrimEnd())</AgentSkillText>
    </PropertyGroup>

    <WriteLinesToFile File="$(AgentSkillFile)" Lines="$([MSBuild]::Escape('$(AgentSkillText)'))" Overwrite="true" WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <TfmSpecificPackageFile Include="$(AgentSkillFile)" PackagePath="skills/stand-sure-functional/" />
    </ItemGroup>
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ProbeRunner</RootNamespace>
    <IsPackable>false</IsPackable>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <!-- Task 07 is an ASP.NET Core minimal-API handler: the model assembly's ASP.NET references must resolve. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- With-library solutions reference StandSure.Functional.dll; the reference puts it on the TPA list. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\StandSure.Functional\StandSure.Functional.csproj" />
  </ItemGroup>
</Project>

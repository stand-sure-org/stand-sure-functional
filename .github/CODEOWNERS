# Paths that run code on contributors' machines or in CI, or that the owner manages directly.
# The main ruleset requires code-owner review, so a change here needs the owner's approval.
/.github/                 @stand-sure
/.githooks/               @stand-sure
/.pre-commit-config.yaml  @stand-sure
/.serena/project.yml      @stand-sure
/.claude/                 @stand-sure
/.agents/                 @stand-sure
/.entire/                 @stand-sure
/fnox.toml                @stand-sure

# Imported into every build: a new package source, a <Target> or an <Exec> here would run everywhere.
# Directory.Packages.props included on purpose (owner, 2026-11-25): the weekly grouped Dependabot NuGet PR needs approval.
/nuget.config              @stand-sure
/global.json               @stand-sure
/Directory.Build.props     @stand-sure
/Directory.Packages.props  @stand-sure
/src/Directory.Build.props @stand-sure
